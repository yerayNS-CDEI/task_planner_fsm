<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>task_planner_fsm</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="yeray.navarro@estudiantat.upc.edu">ynavarro@cdei.upc.edu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ur_msgs</exec_depend>
  <!-- Whole-body sweep controller (task_planner_fsm.wbc). -->
  <exec_depend>controller_manager_msgs</exec_depend>
  <!-- Robot mode / safety mode, for the sweep's hardware gate. The import is
       guarded, so the sweep still runs in simulation without the UR driver. -->
  <exec_depend>ur_dashboard_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- The whole-body sweep's QP solver (task_planner_fsm.wbc.qp). Required,
       not optional: the base pins and the force barrier are constraints only
       OSQP represents, and the node refuses to import without it. rosdep has
       no rule for the Python binding (only the C++ osqp_vendor), so this key
       will not resolve: install it with `pip install osqp`. -->
  <exec_depend>python3-osqp-pip</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>navi_wall</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
